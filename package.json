{
  "name": "lpforge",
  "version": "0.7.2-phase7-ops-ready",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.19 <25"
  },
  "scripts": {
    "clean": "rm -rf .build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "test:unit": "node --test tests/*.test.mjs",
    "test:ci": "pnpm typecheck && pnpm build && node --test tests/*.test.mjs && node scripts/verify-phase1-boundary.mjs && node scripts/verify-phase2-boundary.mjs && node scripts/verify-phase3-boundary.mjs && node scripts/verify-phase4-boundary.mjs && node scripts/verify-phase5-boundary.mjs && node scripts/verify-phase6-boundary.mjs && node scripts/verify-phase7-boundary.mjs && node scripts/verify-discovery-boundary.mjs && node scripts/verify-forward-validation-boundary.mjs && node scripts/verify-post-entry-telemetry-boundary.mjs && node scripts/verify-market-context-telemetry-boundary.mjs && node scripts/verify-inventory-forecast-v2-boundary.mjs && node scripts/verify-migrations.mjs",
    "verify:boundary": "node scripts/verify-phase1-boundary.mjs",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "api": "node --enable-source-maps .build/apps/api/src/main.js",
    "collector": "node --enable-source-maps .build/apps/collector/src/main.js",
    "observer": "node --enable-source-maps .build/apps/observer/src/main.js",
    "replay": "node --enable-source-maps .build/apps/replay/src/main.js",
    "phase1:fixture": "LPFORGE_DATA_MODE=FIXTURE node --enable-source-maps .build/apps/observer/src/main.js fixture-all",
    "lab": "node --enable-source-maps .build/apps/lab/src/main.js",
    "phase2:fixture": "node --enable-source-maps .build/apps/lab/src/main.js fixture-report",
    "verify:phase2": "node scripts/verify-phase2-boundary.mjs",
    "bootstrap:phase2": "bash scripts/bootstrap-phase2.sh",
    "shadow": "node --enable-source-maps .build/apps/shadow/src/main.js",
    "phase3:fixture": "node --enable-source-maps .build/apps/shadow/src/main.js fixture-once",
    "verify:phase3": "node scripts/verify-phase3-boundary.mjs",
    "verify:phase4": "node scripts/verify-phase4-boundary.mjs",
    "paper": "node --enable-source-maps .build/apps/paper/src/main.js",
    "phase4:fixture": "node --enable-source-maps .build/apps/paper/src/main.js fixture-once",
    "phase4:persist-fixture": "node --enable-source-maps .build/apps/paper/src/main.js fixture-once-persist",
    "verify:phase5": "node scripts/verify-phase5-boundary.mjs",
    "executor": "node --enable-source-maps .build/apps/executor/src/main.js",
    "phase5:fixture": "node --enable-source-maps .build/apps/executor/src/main.js fixture-dry-run",
    "verify:postgres:phase5": "node scripts/verify-phase5-postgres-contract.mjs",
    "verify:postgres:reset3c-v3": "node scripts/verify-reset3c-decision-relevant-postgres.mjs",
    "operator": "node --enable-source-maps .build/apps/operator/src/main.js",
    "live:fixture": "node --enable-source-maps .build/apps/operator/src/main.js fixture-once",
    "live:once": "node --enable-source-maps .build/apps/operator/src/main.js live-once",
    "live:shadow": "node --enable-source-maps .build/apps/operator/src/main.js live-run",
    "devnet": "node --enable-source-maps .build/apps/devnet/src/main.js",
    "devnet:preflight": "node --enable-source-maps .build/apps/devnet/src/main.js preflight",
    "devnet:full-cycle": "node --enable-source-maps .build/apps/devnet/src/main.js full-cycle",
    "devnet:position-read": "node --enable-source-maps .build/apps/devnet/src/main.js position-read",
    "devnet:recovery-test": "node --enable-source-maps .build/apps/devnet/src/main.js recovery-fixture",
    "verify:postgres:operational": "node scripts/verify-phase5-operational-postgres.mjs",
    "verify:local:meteora": "node scripts/verify-phase5-local-meteora.mjs",
    "verify:phase6": "node scripts/verify-phase6-boundary.mjs",
    "canary": "node --enable-source-maps .build/apps/canary/src/main.js",
    "canary:capabilities": "node --enable-source-maps .build/apps/canary/src/main.js capabilities",
    "phase6:fixture": "node --enable-source-maps .build/apps/canary/src/main.js fixture-evaluate",
    "verify:postgres:phase6": "node scripts/verify-phase6-postgres.mjs",
    "verify:phase7": "node scripts/verify-phase7-boundary.mjs",
    "production": "node --enable-source-maps .build/apps/production/src/main.js start",
    "production:fixture": "node --enable-source-maps .build/apps/production/src/main.js fixture-once",
    "production:health": "node --enable-source-maps .build/apps/production/src/main.js health-once",
    "production:drift": "node --enable-source-maps .build/apps/production/src/main.js drift-once",
    "production:control": "node --enable-source-maps .build/apps/production/src/main.js control-once",
    "production:runtime": "node --enable-source-maps .build/apps/production/src/main.js runtime-once",
    "production:evidence": "node --enable-source-maps .build/apps/production/src/main.js evidence-once",
    "production:once": "node --enable-source-maps .build/apps/production/src/main.js once",
    "production:start": "node --enable-source-maps .build/apps/production/src/main.js start",
    "production:status": "node --enable-source-maps .build/apps/production/src/main.js status",
    "production:register-release-evidence": "node --enable-source-maps .build/apps/production/src/main.js register-release-evidence",
    "pm2:start": "bash scripts/pm2-start.sh",
    "pm2:start-execution": "bash scripts/pm2-start-execution.sh",
    "pm2:start-discovery": "bash scripts/pm2-start-discovery.sh",
    "pm2:restart": "bash scripts/pm2-restart.sh",
    "pm2:stop": "bash scripts/pm2-stop.sh",
    "pm2:status": "bash scripts/pm2-status.sh",
    "canary:gate-status": "node --enable-source-maps .build/apps/canary/src/main.js gate-status",
    "canary:assert-read-only": "node --enable-source-maps .build/apps/canary/src/main.js assert-read-only",
    "discovery:once": "node --enable-source-maps .build/apps/discovery/src/main.js once",
    "discovery:collect-once": "node --enable-source-maps .build/apps/discovery/src/main.js collect-once",
    "discovery:start": "node --enable-source-maps .build/apps/discovery/src/main.js start",
    "discovery:status": "node --enable-source-maps .build/apps/discovery/src/main.js status",
    "verify:discovery": "node scripts/verify-discovery-boundary.mjs",
    "discovery:learn-once": "node --enable-source-maps .build/apps/discovery-learning/src/main.js once",
    "discovery:learn-start": "node --enable-source-maps .build/apps/discovery-learning/src/main.js start",
    "test:discovery": "node --test tests/pool-discovery-d1d2.test.mjs tests/pool-discovery-d3d8.test.mjs",
    "test:exit": "node --test tests/live-exit-governor.test.mjs tests/live-position-management.test.mjs"
  },
  "dependencies": {
    "@meteora-ag/dlmm": "1.9.10",
    "@solana/web3.js": "1.98.4",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/pg": "8.15.5",
    "typescript": "6.0.3"
  }
}
