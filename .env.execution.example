# LPForge Phase 6 execution worker configuration.
# Copy to .env.execution on the VPS. Never commit the completed file.
# This file is intentionally separate from the read-only lpforge-production .env.

NODE_ENV=production
LPFORGE_CLUSTER=mainnet-beta
SOLANA_RPC_HTTP_URL=<REQUIRED_PRIVATE_SOLANA_RPC_HTTPS_URL>
LPFORGE_P6_PRIVATE_WRITE_RPC_URL=<REQUIRED_PRIVATE_SOLANA_RPC_HTTPS_URL>
LPFORGE_RPC_CLASS=DEDICATED_PRIVATE
LPFORGE_OPERATOR_OWNER_ADDRESS=<REQUIRED_OWNER_PUBLIC_KEY>
LPFORGE_EXECUTION_POLICY_PATH=policies/live-execution-policy.json

# All remain false until a real remote signer and bounded approval are configured.
LIVE_SIGNING=false
LPFORGE_LIVE_EXECUTION=false
LPFORGE_MAINNET_CANARY=false
LPFORGE_P6_EXECUTION_RUNNER_ENABLED=true
LPFORGE_P6_EXECUTION_RUNNER_INTERVAL_MS=5000

# The private key stays in the remote signer/KMS. Do not put it in this file.
LPFORGE_P6_SIGNER_BACKEND_ID=
LPFORGE_P6_SIGNER_CUSTODY_MODE=REMOTE_KMS
LPFORGE_P6_SIGNER_PUBLIC_KEY=<REQUIRED_OWNER_PUBLIC_KEY>
LPFORGE_P6_REMOTE_SIGNER_URL=
LPFORGE_P6_REMOTE_SIGNER_AUTH_TOKEN=
LPFORGE_P6_REMOTE_SIGNER_TIMEOUT_MS=5000

# Attributable, expiring approval for a single authorized deployment window.
LPFORGE_P6_OPERATOR_APPROVAL_ID=
LPFORGE_P6_OPERATOR_APPROVED_BY=
LPFORGE_P6_OPERATOR_APPROVAL_EXPIRES_AT=
