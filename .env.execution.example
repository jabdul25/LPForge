# LPForge Phase 6 execution worker configuration.
# Copy to .env.execution on the VPS. Never commit the completed file.
# This file is intentionally separate from the read-only lpforge-production .env.

NODE_ENV=production
LPFORGE_CLUSTER=mainnet-beta
SOLANA_RPC_HTTP_URL=<REQUIRED_PRIVATE_SOLANA_RPC_HTTPS_URL>
LPFORGE_P6_PRIVATE_WRITE_RPC_URL=<REQUIRED_PRIVATE_SOLANA_RPC_HTTPS_URL>
LPFORGE_RPC_CLASS=DEDICATED_PRIVATE
LPFORGE_OPERATOR_OWNER_ADDRESS=<REQUIRED_OWNER_PUBLIC_KEY>
LPFORGE_EXECUTION_POLICY_PATH=policies/live-execution-policy.json
# PostgreSQL is read only for decision claims and write-only for execution
# evidence. PM2 loads .env before this file, so DATABASE_URL stays in the
# existing ignored .env rather than being duplicated here.

# All remain false until you deliberately enable continuous execution.
LIVE_SIGNING=false
LPFORGE_LIVE_EXECUTION=false
LPFORGE_MAINNET_CANARY=false
LPFORGE_P6_EXECUTION_RUNNER_ENABLED=true
LPFORGE_P6_EXECUTION_RUNNER_INTERVAL_MS=5000
LPFORGE_P6_MAX_FEE_LAMPORTS=100000
LPFORGE_P6_MAX_FEE_FRACTION=0.02
LPFORGE_P6_SIMULATION_FRESHNESS_MS=30000
LPFORGE_P6_RISK_PERMIT_TTL_MS=15000
LPFORGE_P6_MAX_PRESIGN_ACTIVE_BIN_DRIFT_BINS=2
LPFORGE_P6_MAX_PRESIGN_REFERENCE_DIVERGENCE_BPS=250
LPFORGE_P6_CONFIRM_POLL_MS=1000
LPFORGE_P6_CONFIRM_ATTEMPTS=30

# Signer. LOCAL_PRIVATE_KEY matches LPERS/Meribot's base58 .env pattern.
# Enter the base58 private key only in the ignored .env.execution file; never commit or paste it in chat.
LPFORGE_P6_SIGNER_MODE=LOCAL_PRIVATE_KEY
LPFORGE_P6_SIGNER_BACKEND_ID=lpforge-local-mainnet-owner
LPFORGE_P6_SIGNER_CUSTODY_MODE=LOCAL_PRIVATE_KEY
LPFORGE_P6_SIGNER_PUBLIC_KEY=<REQUIRED_OWNER_PUBLIC_KEY>
LPFORGE_P6_PRIVATE_KEY=
# LOCAL_KEYPAIR_FILE, REMOTE_KMS, HARDWARE, and every other owner-signer mode
# are rejected by the production execution worker.

# No expiring per-run approval is required. The enabled policy above and the
# three explicit live switches are the persistent authorization contract.
