# LPForge P1-P7 production environment template.
# Copy to .env on the VPS and replace every <REQUIRED_...> placeholder.
# NEVER commit or send the completed .env file.

NODE_ENV=production
LOG_LEVEL=info

# ---- PostgreSQL ----
DATABASE_URL=postgresql://<REQUIRED_DB_USER>:<REQUIRED_DB_PASSWORD>@127.0.0.1:5432/<REQUIRED_DB_NAME>

# ---- Solana / Meteora ----
# Use a private/dedicated mainnet RPC for production/canary operations.
SOLANA_RPC_HTTP_URL=<REQUIRED_PRIVATE_SOLANA_RPC_HTTPS_URL>
SOLANA_RPC_WS_URL=<OPTIONAL_PRIVATE_SOLANA_RPC_WSS_URL>
METEORA_DATA_API_URL=https://dlmm.datapi.meteora.ag
LPFORGE_CLUSTER=mainnet-beta
LPFORGE_PROGRAM_ID=LBUZKhRxPF3XUpBCjp4YzTKgLccjZhTSDM9YuVaPwxo
METEORA_SDK_VERSION_EXPECTED=1.9.8
LPFORGE_DATA_MODE=LIVE_READ_ONLY
PAIR_UNIVERSE_MODE=CONFIG_ONLY
REFERENCE_PRICE_PROVIDER=DISABLED

# Read-only smoke/assessment pool used by Phase 7 live health/drift.
LPFORGE_SMOKE_POOL_ADDRESS=<REQUIRED_METEORA_DLMM_POOL_ADDRESS>
LPFORGE_SMOKE_POSITION_ADDRESS=

# ---- Runtime identity / source evidence ----
LPFORGE_P7_RUNTIME_ID=lpforge-production
# Must be unique for this VPS/process holder. Example: lpforge-vps-primary-01
LPFORGE_P7_INSTANCE_ID=<REQUIRED_UNIQUE_INSTANCE_ID>
LPFORGE_SOURCE_COMMIT=<REQUIRED_SOURCE_COMMIT_FROM_SOURCE_REVISION>
LPFORGE_P7_POLICY_HASH=<OPTIONAL_FROZEN_POLICY_HASH>
LPFORGE_P7_RELEASE_EVIDENCE_PATH=<REQUIRED_NEW_COMMIT_RELEASE_EVIDENCE_AFTER_VPS_REGRESSION>
LPFORGE_P7_INTERVAL_MS=30000
LPFORGE_P7_LEASE_TTL_MS=60000

# Frozen calibration baseline. Replace only with the approved baseline evidence.
# This is JSON on one line, not a file path.
LPFORGE_P7_DRIFT_BASELINE_JSON=<REQUIRED_APPROVED_PHASE7_DRIFT_BASELINE_JSON>
LPFORGE_P7_DRIFT_WINDOW_HOURS=24
LPFORGE_P7_DECODER_SKIP_RATE=

# ---- Safety defaults: KEEP FALSE until the explicit gated canary/live procedure ----
LIVE_SIGNING=false
LPFORGE_LIVE_EXECUTION=false
LPFORGE_MAINNET_CANARY=false

# Phase-7 authority defaults to OBSERVE_ONLY unless a valid explicit approval envelope is configured.
LPFORGE_P7_AUTHORITY_MODE=OBSERVE_ONLY
LPFORGE_P7_APPROVAL_ID=
LPFORGE_P7_APPROVED_BY=
LPFORGE_P7_APPROVAL_EXPIRES_AT=

# Shadow/public operator fields. Do not place wallet secret material here.
LPFORGE_SHADOW_WALLET_CAPITAL=1
LPFORGE_OPERATOR_OWNER_ADDRESS=
LPFORGE_PREPARE_POSITION_ADDRESS=

# ---- Networking / collection ----
PORT=8080
DATA_API_MAX_RPS=25
HTTP_TIMEOUT_MS=10000
RPC_TIMEOUT_MS=12000
RPC_MIN_INTERVAL_MS=125
RPC_MAX_RETRIES=5
RPC_RETRY_BASE_DELAY_MS=250
RPC_RETRY_MAX_DELAY_MS=4000
COLLECT_INTERVAL_MS=30000
EVENT_BACKFILL_LIMIT=100
EVENT_BACKFILL_START_SLOT=

# ---- Telegram operational alerts ----
# Disabled until bot token/chat ID are populated. Alert delivery failure NEVER grants authority or stops safety gates.
LPFORGE_TELEGRAM_ALERTS_ENABLED=false
LPFORGE_TELEGRAM_BOT_TOKEN=<REQUIRED_IF_TELEGRAM_ENABLED>
LPFORGE_TELEGRAM_CHAT_ID=<REQUIRED_IF_TELEGRAM_ENABLED>
# Optional forum/topic message thread id.
LPFORGE_TELEGRAM_THREAD_ID=
# INFO | WARNING | CRITICAL. WARNING avoids routine-cycle spam.
LPFORGE_TELEGRAM_MIN_SEVERITY=WARNING
LPFORGE_TELEGRAM_TIMEOUT_MS=5000
LPFORGE_TELEGRAM_COOLDOWN_MS=300000
LPFORGE_TELEGRAM_NOTIFY_STARTUP=true

# ---- Devnet validation (not production authority) ----
LPFORGE_DEVNET_EXECUTION_ACK=
LPFORGE_DEVNET_REFERENCE_RPC_URL=https://api.devnet.solana.com
LPFORGE_DEVNET_AIRDROP_LAMPORTS=10000000
LPFORGE_DEVNET_POOL_ADDRESS=
LPFORGE_DEVNET_POSITION_ADDRESS=

# ---- Phase 6 mainnet canary LIVE PATH (WIRED, UNAUTHORIZED BY DEFAULT) ----
# These settings exist so verification can prove the whole live path is present before capital is authorized.
# During read-only soak KEEP the three global flags above FALSE and leave approval fields empty.
LPFORGE_P6_PRIVATE_WRITE_RPC_URL=
# Non-secret policy file containing all pool, capital, and position limits.
LPFORGE_EXECUTION_POLICY_PATH=policies/live-execution-policy.json
LPFORGE_P6_SIGNER_BACKEND_ID=
LPFORGE_P6_SIGNER_CUSTODY_MODE=REMOTE_KMS
# Operator-managed remote signer/KMS HTTP endpoint. Its credential is a secret and never enters Git.
LPFORGE_P6_SIGNER_PUBLIC_KEY=
LPFORGE_P6_REMOTE_SIGNER_URL=
LPFORGE_P6_REMOTE_SIGNER_AUTH_TOKEN=
LPFORGE_P6_REMOTE_SIGNER_TIMEOUT_MS=5000
# Separate PM2 execution process. It refuses to start unless all P6 gates are authorized.
LPFORGE_P6_EXECUTION_RUNNER_ENABLED=false
LPFORGE_P6_EXECUTION_RUNNER_INTERVAL_MS=5000
LPFORGE_P6_OPERATOR_APPROVAL_ID=
LPFORGE_P6_OPERATOR_APPROVED_BY=
LPFORGE_P6_OPERATOR_APPROVAL_EXPIRES_AT=
# Pool capital and position settings intentionally live only in LPFORGE_EXECUTION_POLICY_PATH.
